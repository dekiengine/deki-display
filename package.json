{
  "id": "deki-display",
  "displayName": "Display",
  "minEngine": "0.21.0",
  "buildDefine": "DEKI_PACKAGE_DISPLAY",
  "requires": [
    "deki-spi",
    "deki-gpio",
    "deki-i2c",
    "deki-input",
    "deki-rendering"
  ],
  "features": [
    {
      "id": "panel",
      "displayName": "Display Panel",
      "buildDefine": "DEKI_FEATURE_DISPLAY_PANEL",
      "defaultEnabled": true,
      "componentTypes": [
        "DisplayPanelComponent"
      ]
    },
    {
      "id": "touch",
      "displayName": "Touch Panel",
      "buildDefine": "DEKI_FEATURE_DISPLAY_TOUCH",
      "defaultEnabled": true,
      "componentTypes": [
        "TouchPanelComponent"
      ]
    }
  ],
  "dependencies": {}
}
